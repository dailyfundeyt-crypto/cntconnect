# --- Optional: Google Drive fuer Medien ---
# Ohne diese Werte laufen Notizen normal, Medien bleiben auf der Platte.
# Service-Account-JSON: Console -> IAM -> Service Accounts -> Schluessel erstellen
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Google OAuth (aus .env.local uebernommen) ---
